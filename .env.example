# Atom local development env

# End-user login - Google OAuth Web Client ID.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ADMIN_TOKEN=change-this-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=

# SQLite database for users, sessions, recordings, and delivery state.
ATOM_CONFIG_DIR=config
ATOM_DB_PATH=config/atom.db
RECORDINGS_DIR=api/static/recordings
DEBUG_DIR=api/static/debug

# Core recording flow.
RECORD_MEETING=true
AGENT_NAME=Atom
REC_WIDTH=1280
REC_HEIGHT=720
REC_FORMAT=mp4
BROWSER_CHANNEL=

# Gmail delivery. Use a Gmail app password for the sender account.
GMAIL_SMTP_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_EMAIL=your-sender@gmail.com
EMAIL_ATTACH_LIMIT_MB=20

# Needed when emails should include a full playback link.
APP_BASE_URL=http://127.0.0.1:8000
