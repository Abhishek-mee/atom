# Atom local development env

# End-user login - Google OAuth Web Client ID.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ADMIN_TOKEN=change-this-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=

# SQLite database for users, sessions, metadata, and recording BLOBs.
ATOM_CONFIG_DIR=config
ATOM_DB_PATH=config/atom.db
RECORDINGS_DIR=api/static/recordings
DEBUG_DIR=api/static/debug

# Core recording flow.
RECORD_MEETING=true
AGENT_NAME=Atom
REC_WIDTH=1280
REC_HEIGHT=720
REC_FORMAT=mp4
BROWSER_CHANNEL=

# Maximum size of one recording stored in SQLite.
MAX_RECORDING_DB_MB=200

# Audio-only transcription and meeting summaries.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.4-mini

APP_BASE_URL=http://127.0.0.1:8000
