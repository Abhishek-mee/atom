# ── Atom production env (set these on your host, NOT committed) ───────────────

# Recording
RECORD_MEETING=true
AGENT_NAME=Atom

# Lower resolution to run on a cheap 1GB server (e.g. 854x480). Default 1280x720.
REC_WIDTH=1280
REC_HEIGHT=720

# Output format: mp4 (universal, re-encodes — heavier) | webm (instant stream-copy,
# near-zero CPU, plays in all modern browsers). Use webm on small/cheap hosts.
REC_FORMAT=mp4

# Browser: leave EMPTY in the container → bundled Chromium (works on Linux/ARM).
# Do NOT set "chrome" here (Google Chrome isn't on Linux ARM64).
BROWSER_CHANNEL=

# End-user login — Google OAuth Web Client ID (public).
# Add your production URL to the client's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ADMIN_TOKEN=change-this-long-random-secret
COOKIE_SECURE=true
COOKIE_SAMESITE=none
CORS_ORIGINS=https://atom.abhishek-meena.in

# SQLite database for users, sessions, recordings, and delivery state.
# Mount config/ as a persistent volume in production.
ATOM_CONFIG_DIR=/app/data/config
ATOM_DB_PATH=/app/data/atom.db
RECORDINGS_DIR=/app/data/recordings
DEBUG_DIR=/app/data/debug

# Public app URL used when emails include a playback link.
APP_BASE_URL=https://api.abhishek-meena.in

# Gmail delivery - use a Gmail app password for the sending mailbox.
GMAIL_SMTP_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_EMAIL=your-sender@gmail.com
EMAIL_ATTACH_LIMIT_MB=20

# ── Operator cloud storage (AWS S3) ──────────────────────────────────────────
S3_BUCKET=your-atom-recordings
S3_REGION=us-east-1
S3_PREFIX=recordings/
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_PRESIGN_DAYS=7
S3_KEEP_LOCAL=false      # delete local copy after upload (recommended in prod)
